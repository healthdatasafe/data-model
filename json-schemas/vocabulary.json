{
  "$id": "https://model.datasafe.dev/json-schemas/vocabulary.json",
  "title": "HDS vocabulary",
  "type": "object",
  "required": [
    "binds",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "fhirElement": {
      "type": "string",
      "minLength": 1
    },
    "binds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eventType",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"
          }
        }
      }
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "object",
            "required": [
              "en",
              "fr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "fhir": {
            "type": "string",
            "minLength": 1
          },
          "snomed": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5,17}$"
          }
        }
      }
    }
  }
}