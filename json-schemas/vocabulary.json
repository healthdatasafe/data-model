{
  "$id": "https://model.datasafe.dev/json-schemas/vocabulary.json",
  "title": "HDS vocabulary",
  "type": "object",
  "required": [
    "values"
  ],
  "oneOf": [
    {
      "required": [
        "binds"
      ]
    },
    {
      "required": [
        "codings"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "fhirElement": {
      "type": "string",
      "minLength": 1
    },
    "codings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eventType",
          "path",
          "system"
        ],
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"
          },
          "system": {
            "type": "string",
            "enum": [
              "http://snomed.info/sct"
            ]
          }
        }
      }
    },
    "scales": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "ranked": {
            "type": "boolean"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "binds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eventType",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"
          }
        }
      }
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "object",
            "required": [
              "en",
              "fr"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              },
              "it": {
                "type": "string",
                "minLength": 1
              },
              "pt": {
                "type": "string",
                "minLength": 1
              },
              "pt-BR": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "fhir": {
            "type": "string",
            "minLength": 1
          },
          "snomed": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5,17}$"
          }
        }
      }
    }
  }
}